# Copie para .env na Railway / Fly.io ou ambiente local (NUNCA commite o .env real!)
MW_ENV=production

# Gere chaves fortes com: python -c "import secrets; print(secrets.token_urlsafe(48))"
MW_JWT_SECRET=troque-por-segredo-forte-jwt
MW_PUSH_HMAC_SECRET=troque-por-segredo-forte-push-hmac
MW_ADMIN_API_KEY=troque-por-segredo-forte-admin
MW_BILLING_WEBHOOK_SECRET=troque-por-segredo-forte-webhook
MW_MT5_LICENSE_SECRET=troque-por-segredo-forte-mt5-hmac

# Supabase (PostgreSQL gerenciado via PostgREST — nunca commite a service_role key real)
# Se ambos estiverem preenchidos, a Cloud API usa automaticamente Supabase (6 tabelas).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis REST (obrigatorio em producao multi-worker; fallback MemoryTTLStore em dev)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Fallback SQLite local (usado apenas quando SUPABASE_URL nao esta configurado)
MW_DB_PATH=data/saas_magicwalls.db

# CORS (em producao restrinja para o dominio do Cloudflare Pages)
MW_CORS_ORIGINS=https://app.magicwalls.com.br,http://localhost:5176

# Alertas operacionais no Telegram pessoal (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Anti-rateio & Failover
MW_MAX_DEVICE_SWITCHES_PER_DAY=4
MW_PRIMARY_FAILOVER_SEC=12
MW_HEARTBEAT_STALE_SEC=15
MW_TERMS_VERSION=2026.11
MW_JWT_TTL_SEC=43200
MW_SNAPSHOT_TTL_SEC=300

# Usado apenas pelo produtor local/VPS e scripts/verify_cloud_connections.py
MW_CLOUD_API_URL=https://api.magicwalls.com.br
