populate_jpy_7(float[] pr, string[] lb, color[] cl, int[] wd, string[] st) =>
    array.push(pr, 173.152)
    array.push(lb, "MID WALL")
    array.push(cl, color.new(#90a4ae, 0))
    array.push(wd, 1)
    array.push(st, "dashed")
