    array.push(wd, 1)
    array.push(st, "solid")
    array.push(pr, 3083.100)
    array.push(lb, "MAGICWALL * (SPY 306.0)")
    array.push(cl, color.new(#00e676, 0))
    array.push(wd, 1)
    array.push(st, "solid")
    array.push(pr, 3093.180)
    array.push(lb, "MAGICWALL * (SPY 307.0)")
    array.push(cl, color.new(#00e676, 0))
    array.push(wd, 1)
    array.push(st, "solid")
    true

if barstate.isfirst
    populate_rut_0(rut_prices, rut_labels, rut_colors, rut_widths, rut_styles)

// China 50 / CHINA50 (China)
populate_china_0(float[] pr, string[] lb, color[] cl, int[] wd, string[] st) =>
    array.push(pr, 14290.100)
    array.push(lb, "MAGICWALL ** (SPY 35.0)")
    array.push(cl, color.new(#00e676, 0))
    array.push(wd, 2)
