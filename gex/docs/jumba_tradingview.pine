//@version=6
// +-------------------------------------------------------------------------+
// | Jumba GEX Levels - Unificado 9 Ativos para TradingView                 |
// | Gerado em: 29/05/2026 06:58:14                     |
// | Referências das Coletas:                                                |
// | - WIN Futures  (B3) : 2026-05-28                                         |
// | - SP500 / ES   (EUA): 2026-05-29                                         |
// | - Nasdaq 100   (EUA): 2026-05-29                                         |
// | - Bitcoin / USD(Cript): 2026-05-29                                         |
// | - Dólar Futuro (B3) : 2026-05-29                                         |
// | - EUR / USD    (Forex): 2026-06-18                                         |
// | - GBP / USD    (Forex): 2026-06-18                                         |
// | - Ouro / GLD   (Metal): 2026-05-29                                        |
// | - Dow / DIA    (EUA)  : 2026-05-29                                         |
// |                                                                         |
// | Desenha os níveis automaticamente dependendo do ativo aberto no gráfico!|
// +-------------------------------------------------------------------------+
indicator("Jumba GEX Levels Unified (9 Ativos)", overlay=true, shorttitle="JumbaGEX Unified", max_lines_count=150, max_labels_count=150)

// --- CONFIGURAÇÃO DE DATA ---
g_date         = "Configuração Temporal"
useDateFilter  = input.bool(false, "Filtrar por Data dos Dados", group=g_date)
targetYear     = input.int(2026, "Ano", group=g_date, inline="d1")
targetMonth    = input.int(6, "Mês", group=g_date, inline="d1")
targetDay      = input.int(18, "Dia", group=g_date, inline="d1")

is_target_date = not useDateFilter or (year(time) == targetYear and month(time) == targetMonth and dayofmonth(time) == targetDay)

// --- CONFIGURAÇÃO VISUAL ---
g_visual       = "Configuração Visual"
showLabels     = input.bool(true, "Exibir Legendas das Walls", group=g_visual)
showMidLabels  = input.bool(false, "Exibir Legenda de Mid-Walls", group=g_visual)
showPrices     = input.bool(true, "Exibir Preço na Legenda", group=g_visual)
transparentBg  = input.bool(true, "Fundo da Legenda Transparente", group=g_visual)
labelSize      = input.string(size.small, "Tamanho do Texto", options=[size.auto, size.tiny, size.small, size.normal, size.large], group=g_visual)

// --- INICIALIZAÇÃO DE DADOS ---

