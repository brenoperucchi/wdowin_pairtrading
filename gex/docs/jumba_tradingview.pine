if barstate.isfirst
    populate_jpy_0(jpy_prices, jpy_labels, jpy_colors, jpy_widths, jpy_styles)
    populate_jpy_1(jpy_prices, jpy_labels, jpy_colors, jpy_widths, jpy_styles)
    populate_jpy_2(jpy_prices, jpy_labels, jpy_colors, jpy_widths, jpy_styles)
    populate_jpy_3(jpy_prices, jpy_labels, jpy_colors, jpy_widths, jpy_styles)
    populate_jpy_4(jpy_prices, jpy_labels, jpy_colors, jpy_widths, jpy_styles)
