// --- DETECÇÃO DINÂMICA E FALLBACK DE ATIVO ---
g_asset         = "Configuração de Ativo"
forced_asset    = input.string("Automático", "Forçar Ativo no Gráfico", options=["Automático", "WIN / B3", "SP500 / ES", "Nasdaq 100 / NQ", "Bitcoin / BTC", "Dólar / BRL"], group=g_asset)

is_win_detected = str.contains(syminfo.ticker, "WIN") or str.contains(syminfo.ticker, "IND") or str.contains(syminfo.ticker, "BRA50") or str.contains(syminfo.ticker, "BRA")
is_nq_detected  = str.contains(syminfo.ticker, "QQQ") or str.contains(syminfo.ticker, "NQ") or str.contains(syminfo.ticker, "NDX") or str.contains(syminfo.ticker, "MNQ") or str.contains(syminfo.ticker, "NAS100") or str.contains(syminfo.ticker, "USTEC") or str.contains(syminfo.ticker, "US100")
is_btc_detected = str.contains(syminfo.ticker, "BTC") or str.contains(syminfo.ticker, "ETH")
is_dol_detected = str.contains(syminfo.ticker, "DOL") or str.contains(syminfo.ticker, "WDO") or str.contains(syminfo.ticker, "BRL") or str.contains(syminfo.ticker, "USDBRL")
is_us_detected  = str.contains(syminfo.ticker, "SPY") or str.contains(syminfo.ticker, "ES") or str.contains(syminfo.ticker, "SPX") or str.contains(syminfo.ticker, "MES") or str.contains(syminfo.ticker, "US500") or str.contains(syminfo.ticker, "SPX500") or str.contains(syminfo.ticker, "US 500")

is_win = forced_asset == "WIN / B3" or (forced_asset == "Automático" and is_win_detected)
is_nq  = forced_asset == "Nasdaq 100 / NQ" or (forced_asset == "Automático" and is_nq_detected)
is_btc = forced_asset == "Bitcoin / BTC" or (forced_asset == "Automático" and is_btc_detected)
is_dol = forced_asset == "Dólar / BRL" or (forced_asset == "Automático" and is_dol_detected)
// Fallback inteligente para o SP500 / ES se nenhum outro ativo coincidir
is_us  = forced_asset == "SP500 / ES" or (forced_asset == "Automático" and (is_us_detected or (not is_win and not is_nq and not is_btc and not is_dol)))

var float[] prices = na
var string[] labels = na
var color[] colors = na
var int[] widths = na
var string[] styles = na

if is_win
    prices := win_prices
    labels := win_labels
    colors := win_colors
    widths := win_widths
    styles := win_styles
else if is_nq
    prices := nq_prices
    labels := nq_labels
    colors := nq_colors
    widths := nq_widths
    styles := nq_styles
else if is_btc
    prices := btc_prices
    labels := btc_labels
    colors := btc_colors
    widths := btc_widths
    styles := btc_styles
else if is_dol
    prices := dol_prices
    labels := dol_labels
    colors := dol_colors
    widths := dol_widths
    styles := dol_styles
else if is_us
    prices := us_prices
    labels := us_labels
    colors := us_colors
    widths := us_widths
    styles := us_styles

// --- ENGINE DE PLOTAGEM DINÂMICA DE ALTA PERFORMANCE ---
var line[] active_lines = array.new_line()
var label[] active_labels = array.new_label()
var bool initialized = false

if is_target_date and barstate.islast
    if not initialized
        if not na(prices) and array.size(prices) > 0
            int size = array.size(prices)
            for i = 0 to size - 1
                p = array.get(prices, i)
                lbl = array.get(labels, i)
                col = array.get(colors, i)
                w = array.get(widths, i)
                sty = array.get(styles, i) == "dashed" ? line.style_dashed : line.style_solid
                
                // Desenhar a linha estendida para ambos os lados
                l = line.new(x1=bar_index - 100, y1=p, x2=bar_index, y2=p, xloc=xloc.bar_index, extend=extend.both, color=col, width=w, style=sty)
                
                // Adicionar o rótulo estilizado na margem direita
                lb = label.new(x=bar_index + 12, y=p, text=lbl + " [" + str.tostring(p, "#.##") + "]", xloc=xloc.bar_index, color=color.new(col, 95), textcolor=col, style=label.style_label_left, size=size.small)
                
                array.push(active_lines, l)
                array.push(active_labels, lb)
        initialized := true
    else
        // Acompanhar o deslocamento do gráfico em tempo real para manter as labels à direita
        int size = array.size(active_lines)
        if size > 0
            for i = 0 to size - 1
                label.set_x(array.get(active_labels, i), bar_index + 12)
