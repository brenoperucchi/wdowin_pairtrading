// WIN Futures (B3)
populate_win_0(float[] pr, string[] lb, color[] cl, int[] wd, string[] st) =>
    array.push(pr, 142012.612)
    array.push(lb, "MAGICWALL *** (IBOV 140000)")
    array.push(cl, color.new(#00e676, 0))
    array.push(wd, 3)
    array.push(st, "solid")
    array.push(pr, 142166.352)
    array.push(lb, "MIN GAMMA (Piso)")
    array.push(cl, color.new(#ff1744, 0))
    array.push(wd, 3)
    array.push(st, "solid")
    array.push(pr, 169640.151)
    array.push(lb, "GAMMA FLIP (Pivot)")
    array.push(cl, color.new(#ffd600, 0))
    array.push(wd, 2)
    array.push(st, "solid")
    array.push(pr, 205008.000)
    array.push(lb, "MAX GAMMA (Teto)")
    array.push(cl, color.new(#00b0ff, 0))
    array.push(wd, 3)
    array.push(st, "solid")
    true

if barstate.isfirst
    populate_win_0(win_prices, win_labels, win_colors, win_widths, win_styles)

