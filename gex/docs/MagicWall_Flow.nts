BEGIN
  clMagicWall := clLime;
  clMidleWall := clGray;
  clMidWallFibo := clDkGray;
  clFlip := clYellow;
  clMaxGamma:= clGreen;
  clMinGamma := clRed;
  stlMidleWall := 1;
  stlMidWallFibo := 2;

  isWIN := (GetAsset() = "WINFUT") or (GetAsset() = "INDFUT") or (GetAsset() = "WINV26") or (GetAsset() = "INDV26") or (GetAsset() = "WINZ26") or (GetAsset() = "INDZ26") or (GetAsset() = "WING27") or (GetAsset() = "INDG27");
  isDOL := (GetAsset() = "DOLFUT") or (GetAsset() = "WDOFUT") or (GetAsset() = "WDOU26") or (GetAsset() = "DOLU26") or (GetAsset() = "WDOV26") or (GetAsset() = "DOLV26") or (GetAsset() = "WDOX26") or (GetAsset() = "DOLX26");

  // ── 1. MOTOR DE FLUXO DE AGRESSÃO PONDERADO POR LOTE (PROXY INSTITUCIONAL) ──
  volCompra := AgressionVolBuy;
  volVenda := AgressionVolSell;
  volTotal := volCompra + volVenda;
  saldoAgr := AgressionVolBalance;
  mediaVol := Max(1, Media(20, volTotal));

  negocios := Max(1, Trades);
  loteMedio := volTotal / negocios;
  mediaLote := Max(1, Media(20, loteMedio));
  pesoInst := loteMedio / mediaLote;
  if pesoInst > 3.0 then pesoInst := 3.0;
  if pesoInst < 0.5 then pesoInst := 0.5;

  deltaInstProxy := saldoAgr * pesoInst;
  if (Date <> Date[1]) then
    cvdInst := deltaInstProxy
  else
    cvdInst := cvdInst[1] + deltaInstProxy;

  emaFast := MediaExp(4, cvdInst);
  emaSlow := MediaExp(11, cvdInst);
  passoCvd := Max(1, MediaExp(7, Abs(deltaInstProxy)));
  oscCvd := ((emaFast - emaSlow) / (passoCvd * 1.4)) * 55.0;
  histFluxo := MediaExp(3, oscCvd);

  // Histerese da Janela A.S.G (+6.5 / -6.5)
  if (Date <> Date[1]) then
  begin
    if histFluxo >= 0 then janelaDir := 1 else janelaDir := -1;
    barraUltimoSinal := 0;
  end
  else
  begin
    janelaDir := janelaDir[1];
    barraUltimoSinal := barraUltimoSinal[1];
    if (janelaDir = 1) and (histFluxo <= -6.5) then janelaDir := -1;
    if (janelaDir = -1) and (histFluxo >= 6.5) then janelaDir := 1;
  end;

  if volTotal > 0 then
    desequilibrioPct := (saldoAgr / volTotal) * 100.0
  else
    desequilibrioPct := 0;

  if (((Date >= ELDate(2026, 10, 28)) and (Time >= 900) and (Time <= 1900))) then
  begin
    if isWIN then
    begin
      emZonaSuporte := false;
      emZonaResistencia := false;
      line1 := 156586.935;
      line1IsMid := false;
      line1Style := 0;
      line1Width := 3;
      if UsarPolaridadeDinamica then begin if Close >= line1 then line1Color := clLime else line1Color := clRed; end else line1Color := clMinGamma;
      if (Low - RaioWallWIN <= line1) and (High + RaioWallWIN >= line1) then
      begin
        if DestacarDefesaNaWall and (not line1IsMid) and (volTotal >= mediaVol * FatorLoteDefesa) then line1Width := 4;
        if (Close >= line1) and (Low - RaioWallWIN <= line1) then emZonaSuporte := true;
        if (Close <= line1) and (High + RaioWallWIN >= line1) then emZonaResistencia := true;
      end;
      SetPlotColor(1, line1Color);
      SetPlotWidth(1, line1Width);
      SetPlotStyle(1, line1Style);
      Plot(line1);
      line2 := 168346.866;
      line2IsMid := false;
      line2Style := 0;
      line2Width := 1;
      if UsarPolaridadeDinamica then begin if Close >= line2 then line2Color := clLime else line2Color := clRed; end else line2Color := clRed;
