        if (Close <= line24) and (High + RaioWallWDO >= line24) then emZonaResistencia := true;
      end;
      SetPlotColor(24, line24Color);
      SetPlotWidth(24, line24Width);
      SetPlotStyle(24, line24Style);
      Plot24(line24);
      line25 := 5500.000;
      line25IsMid := false;
      line25Style := 0;
      line25Width := 3;
      if UsarPolaridadeDinamica then begin if Close >= line25 then line25Color := clLime else line25Color := clRed; end else line25Color := clLime;
      if (Low - RaioWallWDO <= line25) and (High + RaioWallWDO >= line25) then
      begin
        if DestacarDefesaNaWall and (not line25IsMid) and (volTotal >= mediaVol * FatorLoteDefesa) then line25Width := 4;
        if (Close >= line25) and (Low - RaioWallWDO <= line25) then emZonaSuporte := true;
        if (Close <= line25) and (High + RaioWallWDO >= line25) then emZonaResistencia := true;
      end;
      SetPlotColor(25, line25Color);
      SetPlotWidth(25, line25Width);
      SetPlotStyle(25, line25Style);
      Plot25(line25);
      line26 := 5504.290;
      line26IsMid := false;
      line26Style := 0;
      line26Width := 3;
      if UsarPolaridadeDinamica then begin if Close >= line26 then line26Color := clLime else line26Color := clRed; end else line26Color := clMaxGamma;
      if (Low - RaioWallWDO <= line26) and (High + RaioWallWDO >= line26) then
      begin
        if DestacarDefesaNaWall and (not line26IsMid) and (volTotal >= mediaVol * FatorLoteDefesa) then line26Width := 4;
        if (Close >= line26) and (Low - RaioWallWDO <= line26) then emZonaSuporte := true;
        if (Close <= line26) and (High + RaioWallWDO >= line26) then emZonaResistencia := true;
      end;
      SetPlotColor(26, line26Color);
      SetPlotWidth(26, line26Width);
      SetPlotStyle(26, line26Style);
      Plot26(line26);
      line27 := 5525.000;
      line27IsMid := true;
      line27Style := stlMidleWall;
      line27Width := 1;
      if UsarPolaridadeDinamica then begin if Close >= line27 then line27Color := clGreen else line27Color := clMaroon; end else line27Color := clMidleWall;
      if (Low - RaioWallWDO <= line27) and (High + RaioWallWDO >= line27) then
      begin
        if DestacarDefesaNaWall and (not line27IsMid) and (volTotal >= mediaVol * FatorLoteDefesa) then line27Width := 3;
        if (Close >= line27) and (Low - RaioWallWDO <= line27) then emZonaSuporte := true;
        if (Close <= line27) and (High + RaioWallWDO >= line27) then emZonaResistencia := true;
      end;
      SetPlotColor(27, line27Color);
      SetPlotWidth(27, line27Width);
      SetPlotStyle(27, line27Style);
      Plot27(line27);
      line28 := 5550.000;
      line28IsMid := false;
      line28Style := 0;
      line28Width := 1;
      if UsarPolaridadeDinamica then begin if Close >= line28 then line28Color := clLime else line28Color := clRed; end else line28Color := clLime;
      if (Low - RaioWallWDO <= line28) and (High + RaioWallWDO >= line28) then
      begin
        if DestacarDefesaNaWall and (not line28IsMid) and (volTotal >= mediaVol * FatorLoteDefesa) then line28Width := 3;
        if (Close >= line28) and (Low - RaioWallWDO <= line28) then emZonaSuporte := true;
        if (Close <= line28) and (High + RaioWallWDO >= line28) then emZonaResistencia := true;
      end;
      SetPlotColor(28, line28Color);
      SetPlotWidth(28, line28Width);
      SetPlotStyle(28, line28Style);
      Plot28(line28);
      line29 := 5575.000;
      line29IsMid := true;
      line29Style := stlMidleWall;
      line29Width := 1;
      if UsarPolaridadeDinamica then begin if Close >= line29 then line29Color := clGreen else line29Color := clMaroon; end else line29Color := clMidleWall;
      if (Low - RaioWallWDO <= line29) and (High + RaioWallWDO >= line29) then
      begin
        if DestacarDefesaNaWall and (not line29IsMid) and (volTotal >= mediaVol * FatorLoteDefesa) then line29Width := 3;
        if (Close >= line29) and (Low - RaioWallWDO <= line29) then emZonaSuporte := true;
        if (Close <= line29) and (High + RaioWallWDO >= line29) then emZonaResistencia := true;
      end;
      SetPlotColor(29, line29Color);
      SetPlotWidth(29, line29Width);
      SetPlotStyle(29, line29Style);
      Plot29(line29);
      line30 := 5600.000;
      line30IsMid := false;
      line30Style := 0;
      line30Width := 1;
      if UsarPolaridadeDinamica then begin if Close >= line30 then line30Color := clLime else line30Color := clRed; end else line30Color := clLime;
      if (Low - RaioWallWDO <= line30) and (High + RaioWallWDO >= line30) then
      begin
        if DestacarDefesaNaWall and (not line30IsMid) and (volTotal >= mediaVol * FatorLoteDefesa) then line30Width := 3;
        if (Close >= line30) and (Low - RaioWallWDO <= line30) then emZonaSuporte := true;
        if (Close <= line30) and (High + RaioWallWDO >= line30) then emZonaResistencia := true;
      end;
      SetPlotColor(30, line30Color);
      SetPlotWidth(30, line30Width);
      SetPlotStyle(30, line30Style);
      Plot30(line30);
    end
    else
    begin
      NoPlot(1);
      NoPlot(2);
      NoPlot(3);
      NoPlot(4);
      NoPlot(5);
      NoPlot(6);
      NoPlot(7);
      NoPlot(8);
      NoPlot(9);
      NoPlot(10);
      NoPlot(11);
      NoPlot(12);
      NoPlot(13);
      NoPlot(14);
      NoPlot(15);
      NoPlot(16);
      NoPlot(17);
      NoPlot(18);
      NoPlot(19);
      NoPlot(20);
      NoPlot(21);
      NoPlot(22);
      NoPlot(23);
      NoPlot(24);
      NoPlot(25);
      NoPlot(26);
      NoPlot(27);
      NoPlot(28);
      NoPlot(29);
      NoPlot(30);
    end;

    // ── 2. AVALIAÇÃO DE DEFESA NA WALL + EXPLOSÃO DE FLUXO ──
    if isWIN or isDOL then
    begin
      rangeBarra := High - Low;
      if Open < Close then pavioInf := Open - Low else pavioInf := Close - Low;
      if Open > Close then pavioSup := High - Open else pavioSup := High - Close;

      sinalCompraWall := false;
      sinalVendaWall := false;
      sinalCompraFluxo := false;
      sinalVendaFluxo := false;

      if rangeBarra > 0 then
      begin
        // Regra 1: Compra por Absorção / Defesa na Wall de Suporte
        if emZonaSuporte and (Close >= Low + rangeBarra * 0.50) and (volTotal >= mediaVol * 0.85) and
           (((pavioInf >= rangeBarra * 0.32) and ((saldoAgr < 0) or (deltaInstProxy > 0))) or
            ((Close > Open) and (pesoInst >= 1.15) and (saldoAgr > 0))) then
          sinalCompraWall := true;

        // Regra 2: Venda por Rejeição / Absorção na Wall de Resistência
        if emZonaResistencia and (Close <= High - rangeBarra * 0.50) and (volTotal >= mediaVol * 0.85) and
           (((pavioSup >= rangeBarra * 0.32) and ((saldoAgr > 0) or (deltaInstProxy < 0))) or
            ((Close < Open) and (pesoInst >= 1.15) and (saldoAgr < 0))) then
          sinalVendaWall := true;

        // Regra 3: Compra por Explosão de Fluxo Institucional
        if (not sinalCompraWall) and (Close > Open) and (pesoInst >= 1.25) and
           (volTotal >= mediaVol * 1.25) and (desequilibrioPct >= 12.0) and (janelaDir = 1) then
          sinalCompraFluxo := true;

        // Regra 4: Venda por Explosão de Fluxo Institucional
        if (not sinalVendaWall) and (Close < Open) and (pesoInst >= 1.25) and
           (volTotal >= mediaVol * 1.25) and (desequilibrioPct <= -12.0) and (janelaDir = -1) then
          sinalVendaFluxo := true;
      end;

      // Se ApenasAFavorDaJanela = true (Metodologia 2), bloqueia sinais contra a Janela A.S.G
      if ApenasAFavorDaJanela then
      begin
        if janelaDir = 1 then
        begin
          sinalVendaWall := false;
          sinalVendaFluxo := false;
        end
        else
        begin
          sinalCompraWall := false;
          sinalCompraFluxo := false;
        end;
      end;

      // ── 3. PINTURA DOS CANDLES (FLUXO REAL A.S.G + DEFESA NA WALL) ──
      if ColorirVelasFluxoASG then
      begin
        if sinalCompraWall then
          PaintBar(clAqua)
        else if sinalVendaWall then
          PaintBar(clFuchsia)
        else if janelaDir = 1 then
        begin
          if (Close >= Open) or (saldoAgr >= 0) then
            PaintBar(clLime)
          else
            PaintBar(clSilver); // Pullback / Respiro dentro da Janela Verde
        end
        else
        begin
          if (Close <= Open) or (saldoAgr <= 0) then
            PaintBar(clRed)
          else
            PaintBar(clSilver); // Pullback / Respiro dentro da Janela Vermelha
        end;
      end;

      // ── 4. SETINHAS OPERACIONAIS NO GRÁFICO (COM COOLDOWN DE 3 BARRAS) ──
      if MostrarSetasSinais and ((CurrentBar - barraUltimoSinal) >= 3) then
      begin
        if sinalCompraWall then
        begin
          PlotText("▲ WALL", clAqua, 0, 10);
          barraUltimoSinal := CurrentBar;
        end
        else if sinalVendaWall then
        begin
          PlotText("▼ WALL", clFuchsia, 2, 10);
          barraUltimoSinal := CurrentBar;
        end
        else if sinalCompraFluxo then
        begin
          PlotText("▲ FLUXO", clLime, 0, 9);
          barraUltimoSinal := CurrentBar;
        end
        else if sinalVendaFluxo then
        begin
          PlotText("▼ FLUXO", clRed, 2, 9);
          barraUltimoSinal := CurrentBar;
        end;
      end;
    end;
  end
  else
  begin
      NoPlot(1);
      NoPlot(2);
      NoPlot(3);
      NoPlot(4);
      NoPlot(5);
      NoPlot(6);
      NoPlot(7);
      NoPlot(8);
      NoPlot(9);
      NoPlot(10);
      NoPlot(11);
      NoPlot(12);
      NoPlot(13);
      NoPlot(14);
      NoPlot(15);
      NoPlot(16);
      NoPlot(17);
      NoPlot(18);
      NoPlot(19);
      NoPlot(20);
      NoPlot(21);
      NoPlot(22);
      NoPlot(23);
      NoPlot(24);
      NoPlot(25);
      NoPlot(26);
      NoPlot(27);
      NoPlot(28);
      NoPlot(29);
      NoPlot(30);
  end;
END;
